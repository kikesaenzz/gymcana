{
    "redirects": [
        {
            "source": "/(.*)",
            "destination": "https://gincana-boda.vercel.app/$1",
            "permanent": true,
            "has": [
                { "type": "host", "value": "gymkana-boda-nu.vercel.app" }
            ]
        }
    ],
    "headers": [
        {
            "source": "/manifest.webmanifest",
            "headers": [
                { "key": "Content-Type", "value": "application/manifest+json" }
            ]
        }
    ]
}
